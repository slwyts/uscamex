{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uscamex-worker",
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "vgf3akr3-uscamex-worker.hashfi.fun",
      "custom_domain": true,
      "previews_enabled": false
    }
  ],
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OPERATOR",
        "class_name": "OperatorDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OperatorDO"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uscamex_operator",
      "database_id": "a150762d-03d0-4dcb-8a35-c9720c1d8357",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "OPERATOR_MAINTENANCE_PAUSED": "false",
    "CHAIN_ID": "56",
    "TOKEN_ADDRESS": "0xA85e6A301b45A8e683E8B66A87B3D27C6abcb092",
    "PANCAKE_V2_ROUTER": "0x10ED43C718714eb63d5aA57B78B54704E256024E",
    "BURN_ADDRESS": "0x000000000000000000000000000000000000dEaD",
    "CONFIRMATIONS": "1",
    "INDEXER_START_BLOCK": "103580890",
    "EXECUTOR_SLIPPAGE_BPS": "500",
    "TRANSACTION_DEADLINE_SECONDS": "600",
    "RPC_MAX_BLOCKS_PER_SCAN": "1000",
    "RPC_CONFIG_TTL_SECS": "300",
    "RPC_NODES_TTL_SECS": "60",
    "RPC_RESERVES_TTL_SECS": "30",
    "RPC_VAULT_BALANCE_TTL_SECS": "30",
    // AMM swap fee numerator. BSC PancakeSwap = 9975 (0.25%); Polygon QuickSwap/Sushi = 9970 (0.30%).
    // Defaults by chain id when unset; the operator also tries to auto-detect from the pair.
    "AMM_FEE_BPS": "9975",
    // --- Chain metadata (served to admin frontend via /api/health) ---
    "CHAIN_NAME": "BNB Smart Chain Mainnet",
    "EXPLORER_URL": "https://bscscan.com",
    "NATIVE_CURRENCY_NAME": "BNB",
    "NATIVE_CURRENCY_SYMBOL": "BNB",
    "NATIVE_CURRENCY_DECIMALS": "18"
  }
}
